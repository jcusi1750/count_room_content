"""
weekly_content.py
------------------
Builds ONE aggregate weekly card per sport - counts only, never
individual wallet names, labels, or addresses. This is the safety
boundary: no matter what's in the underlying JSON (real handles,
addresses, whale labels), this script only ever reads totals.

Run manually any time:
    python3 weekly_content.py

Or let the launchd job run it automatically.
"""

import json
import os
import re
import subprocess
from datetime import datetime, timedelta

import render_card
from telegram_hook import send_telegram_message

PHONE_NUMBER = "+13122181509"

SPORTS = [
    ("MLB", "~/wallet_scout/wallet_scout_results.json"),
    ("Soccer", "~/wallet_scout_soccer/soccer_scout_results.json"),
    ("NBA", "~/wallet_scout_nba/nba_scout_results.json"),
    ("Politics", "~/wallet_scout/watchlist_politics.json"),
    ("Econ", "~/wallet_scout/watchlist_econ.json"),
]

WATCHING_RE = re.compile(r"WATCHING - (\d+)/(\d+) days")


def load_results(path):
    full_path = os.path.expanduser(path)
    if not os.path.exists(full_path):
        return None
    with open(full_path) as f:
        return json.load(f)


def summarize_sport(sport_name, results):
    one_week_ago = datetime.now() - timedelta(days=7)

    total = len(results)
    new_this_week = 0
    failed_this_week = 0
    watchlist_added_this_week = 0
    ready = 0
    watching = 0
    failed = 0
    closest_progress = None
    oldest_first_seen = None

    for addr, entry in results.items():
        status = entry.get("status", "")

        first_seen = entry.get("first_seen")
        is_new_this_week = False
        if first_seen:
            try:
                seen_date = datetime.strptime(first_seen, "%Y-%m-%d")
                if oldest_first_seen is None or seen_date < oldest_first_seen:
                    oldest_first_seen = seen_date
                if seen_date >= one_week_ago:
                    new_this_week += 1
                    is_new_this_week = True
            except ValueError:
                pass

        if status.startswith("READY"):
            ready += 1
        elif status.startswith("WATCHING"):
            watching += 1
            if is_new_this_week:
                watchlist_added_this_week += 1
            match = WATCHING_RE.search(status)
            if match:
                current, threshold = int(match.group(1)), int(match.group(2))
                if closest_progress is None or current > closest_progress[0]:
                    closest_progress = (current, threshold)
        elif status.startswith("FAIL"):
            failed += 1
            if is_new_this_week:
                failed_this_week += 1

    tracker_age_days = None
    is_immature = False
    if oldest_first_seen is not None:
        tracker_age_days = (datetime.now() - oldest_first_seen).days
        is_immature = tracker_age_days < 14 and sport_name not in ("MLB", "Soccer", "NBA")

    return {
        "sport": sport_name,
        "total": total,
        "new_this_week": new_this_week,
        "failed_this_week": failed_this_week,
        "watchlist_added_this_week": watchlist_added_this_week,
        "ready": ready,
        "watching": watching,
        "failed": failed,
        "closest_progress": closest_progress,
        "tracker_age_days": tracker_age_days,
        "is_immature": is_immature,
    }


def build_entries(summaries):
    entries = []
    for s in summaries:
        if s is None:
            continue

        if s["is_immature"]:
            entries.append({
                "headline": f"This Week: {s['sport']}",
                "context": (
                    f"Tracker started {s['tracker_age_days']} days ago - weekly numbers "
                    f"still include initial backfill and aren't representative yet. "
                    f"Wait until day 14+ before posting this vertical."
                ),
                "tag": "DATA STILL AGING - DO NOT POST",
            })
            continue

        if s["new_this_week"] == 0 and s["watching"] == 0:
            entries.append({
                "headline": f"This Week: {s['sport']}",
                "context": (
                    f"No wallets screened - {s['sport']} is between seasons. "
                    f"Screening resumes when games return."
                ),
                "tag": "OFFSEASON - DO NOT POST",
            })
            continue

        context_parts = [
            f"{s['new_this_week']} new wallet{'s' if s['new_this_week'] != 1 else ''} screened this week "
            f"({s['failed_this_week']} disqualified, {s['watchlist_added_this_week']} entered watchlist).",
            f"Currently watching {s['watching']} wallet{'s' if s['watching'] != 1 else ''}.",
        ]
        if s["ready"] > 0:
            context_parts.append(f"{s['ready']} passed all screens.")
        if s["closest_progress"]:
            current, threshold = s["closest_progress"]
            context_parts.append(f"Closest candidate: day {current} of {threshold}.")

        entries.append({
            "headline": f"This Week: {s['sport']}",
            "context": " ".join(context_parts),
            "tag": "WEEKLY SCAN",
        })
    return entries


def send_notification(summaries, num_cards):
    lines = ["WEEKLY CONTENT READY"]
    immature_sports = []
    for s in summaries:
        if s is None:
            continue
        if s["is_immature"]:
            lines.append(f"{s['sport']}: TRACKER TOO NEW ({s['tracker_age_days']}d) - DO NOT POST")
            immature_sports.append(s['sport'])
        else:
            lines.append(f"{s['sport']}: {s['new_this_week']} new, {s['watching']} watching")
    lines.append(f"\n{num_cards} card(s) generated in ~/count_room_content/output/")
    if immature_sports:
        lines.append(f"Skip posting: {', '.join(immature_sports)}")
    lines.append("Review and post when you're back on the Mac.")
    message = "\n".join(lines)

    script = (
        'tell application "Messages"\n'
        '    set targetService to 1st service whose service type = iMessage\n'
        f'    set targetBuddy to buddy "{PHONE_NUMBER}" of targetService\n'
        f'    send "{message}" to targetBuddy\n'
        'end tell'
    )
    subprocess.run(["osascript", "-e", script])
    send_telegram_message(message)


def main():
    summaries = []
    for sport_name, path in SPORTS:
        results = load_results(path)
        if results is None:
            print(f"{sport_name}: not built yet, skipping")
            summaries.append(None)
            continue
        summaries.append(summarize_sport(sport_name, results))

    entries = build_entries(summaries)

    if not entries:
        print("No data available from any sport - nothing generated.")
        return

    render_card.ENTRIES = entries
    written_count = render_card.main(subfolder="wallet_scout")

    send_notification(summaries, len(entries))
    print("\niMessage notification sent.")


if __name__ == "__main__":
    main()
